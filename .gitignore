# ============================================
# AI Interview Agent - Git 忽略规则
# ============================================
# 类似 Java 项目的 .gitignore，防止敏感文件和临时文件被提交

# ════════════════════════════════════════════
# Python 相关
# ════════════════════════════════════════════

# 字节码文件（类似Java的.class文件）
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境（非常重要！）
venv/
.venv/
env/
.env.local/

# 分发/打包
dist/
build/
*.egg-info/
*.egg

# 测试相关
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ════════════════════════════════════════════
# 敏感信息（绝对不能提交！）
# ════════════════════════════════════════════

# 环境变量文件（包含API Key等敏感信息）
.env
.env.local
.env.*.local

# 密钥文件
*.pem
*.key
secrets/

# ════════════════════════════════════════════
# IDE 相关
# ════════════════════════════════════════════

# PyCharm
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/

# Jupyter Notebook
.ipynb_checkpoints/

# ════════════════════════════════════════════
# 数据库和缓存
# ════════════════════════════════════════════

# ChromaDB 向量数据库
chroma_db/
chromadb_data/

# Redis 持久化文件
dump.rdb

# SQLite 数据库
*.db
*.sqlite3

# ════════════════════════════════════════════
# 日志和临时文件
# ════════════════════════════════════════════

logs/
*.log
*.tmp
*.temp
*.swp
*.swo

# ════════════════════════════════════════════
# 操作系统
# ════════════════════════════════════════════

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ════════════════════════════════════════════
# 项目特定
# ════════════════════════════════════════════

# 上传的简历文件
uploads/
resumes/

# 生成的报告
reports/
exports/
