# ============================================
# AI Interview Agent - 环境变量配置示例
# ============================================
# ⚠️ 重要：这是示例文件！实际使用时复制为 .env 并填入真实值
# ⚠️ .env 文件不要提交到Git！（已添加到.gitignore）
#
# 类似Java的 application.yml 或 application.properties
# 但用于存储敏感信息（API Key、密码等）
# ============================================

# ---------- 应用基础配置 ----------
APP_NAME=AI-Interview-Agent-Python
APP_ENV=development            # 开发环境: development / 生产: production
PYTHON_SERVICE_PORT=8083       # 服务端口（类似server.port=8083）
DEBUG=true                     # 调试模式开关

# ---------- 智谱AI GLM-4 配置（LLM大脑） ----------
ZHIPUAI_API_KEY=your_api_key_here  # ⚠️ 替换为你的智谱API Key
ZHIPUAI_MODEL=glm-4-plus           # 模型名称：glm-4-plus(旗舰) / glm-4-flashx(免费测试)
ZHIPUAI_API_BASE=https://open.bigmodel.cn/api/paas/v4

# ---------- 阿里云OSS配置（简历文件存储） ----------
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com    # OSS endpoint（根据地域调整）
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id_here   # ⚠️ RAM子账号的AccessKey ID
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret_here  # ⚠️ AccessKey Secret
ALIYUN_OSS_BUCKET_NAME=your_bucket_name_here        # Bucket名称（如：ai-interview-resumes）

# ---------- Redis配置（会话缓存） ----------
REDIS_HOST=localhost           # Redis地址（本地开发用localhost）
REDIS_PORT=6379               # Redis端口
REDIS_PASSWORD=               # Redis密码（无密码则留空）
REDIS_DB=0                    # Redis数据库编号
REDIS_SESSION_TTL=7200         # 会话过期时间（秒），2小时

# ---------- ChromaDB向量数据库配置（RAG核心） ----------
CHROMA_PERSIST_DIR=./chroma_db          # 数据持久化目录
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5  # Embedding模型（中文效果最好，免费）

# ---------- Java后端对接地址 ----------
JAVA_BACKEND_URL=http://localhost:8082   # Java Spring Boot服务地址
